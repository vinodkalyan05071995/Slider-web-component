{% comment %}
  slider-element — example Shopify section.
  1. Copy dist/slider-element.min.js and dist/slider-element.min.css into your theme's assets/ folder.
  2. Save this file as sections/slider-element-gallery.liquid.
  3. Add the "Slider gallery" section in the theme editor and add image blocks.
{% endcomment %}

{{ 'slider-element.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'slider-element.min.js' | asset_url }}" defer></script>

{%- liquid
  assign slider_id = 'SliderElement-' | append: section.id
  assign per_view_desktop = section.settings.per_view_desktop
  assign per_move_desktop = 1
  if section.settings.move_by_page
    assign per_move_desktop = per_view_desktop
  endif
-%}

<div class="slider-element-section page-width">
  {%- if section.settings.heading != blank -%}
    <h2 id="{{ slider_id }}-heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <slider-element
    id="{{ slider_id }}"
    {% if section.settings.heading != blank %}aria-labelledby="{{ slider_id }}-heading"{% else %}label="{{ 'Image gallery' | escape }}"{% endif %}
    per-view="{{ section.settings.per_view_mobile }}"
    gap="{{ section.settings.gap }}"
    speed="{{ section.settings.speed }}"
    {% if section.settings.transition == 'fade' %}transition="fade"{% endif %}
    {% if section.settings.loop %}loop{% endif %}
    {% if section.settings.autoplay %}autoplay="{{ section.settings.autoplay_interval | times: 1000 }}"{% endif %}
    {% if section.settings.show_thumbnails or section.settings.show_pagination == false %}no-pagination{% endif %}
    breakpoints='{"750": {"perView": {{ per_view_desktop }}, "perMove": {{ per_move_desktop }}}}'
  >
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        {%- capture image_html -%}
          {%- liquid
            # The first slide of a section near the top of the page is likely the LCP image: load it right away.
            assign loading = 'lazy'
            assign priority = 'auto'
            if forloop.first and section.index <= 2
              assign loading = 'eager'
              assign priority = 'high'
            endif
          -%}
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1600 | image_tag:
              loading: loading,
              fetchpriority: priority,
              widths: '375, 750, 1100, 1600',
              sizes: '(min-width: 750px) 50vw, 100vw',
              alt: block.settings.image.alt
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        {%- endcapture -%}

        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ image_html }}</a>
        {%- else -%}
          {{ image_html }}
        {%- endif -%}

        {%- if block.settings.caption != blank -%}
          <p class="slider-element-section__caption">{{ block.settings.caption | escape }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </slider-element>

  {%- if section.settings.show_thumbnails and section.blocks.size > 1 -%}
    <slider-element
      class="slider-element-section__thumbs"
      nav-for="{{ slider_id }}"
      label="{{ 'Gallery thumbnails' | escape }}"
      per-view="4"
      gap="8"
      no-pagination
      breakpoints='{"750": {"perView": 6}}'
    >
      {%- for block in section.blocks -%}
        <div>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </slider-element>
  {%- endif -%}
</div>

{% style %}
  #{{ slider_id }} img,
  #{{ slider_id }} .placeholder-svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: {{ section.settings.aspect_ratio }};
    object-fit: cover;
    border-radius: {{ section.settings.radius }}px;
  }
  .slider-element-section__thumbs { margin-top: 0.75rem; }
  .slider-element-section__thumbs img,
  .slider-element-section__thumbs .placeholder-svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 6px;
  }
  .slider-element-section__caption { margin: 0.5rem 0 0; }
{% endstyle %}

{% schema %}
{
  "name": "Slider gallery",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gallery" },
    {
      "type": "select",
      "id": "transition",
      "label": "Transition",
      "options": [
        { "value": "slide", "label": "Slide" },
        { "value": "fade", "label": "Fade" }
      ],
      "default": "slide"
    },
    { "type": "range", "id": "per_view_mobile", "label": "Slides per view (mobile)", "min": 1, "max": 3, "step": 1, "default": 1 },
    { "type": "range", "id": "per_view_desktop", "label": "Slides per view (desktop)", "min": 1, "max": 6, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "move_by_page", "label": "Move a full page at a time on desktop", "default": false },
    { "type": "range", "id": "gap", "label": "Gap", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "speed", "label": "Transition speed", "min": 100, "max": 1500, "step": 100, "unit": "ms", "default": 400 },
    { "type": "checkbox", "id": "loop", "label": "Loop", "default": true },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": false },
    { "type": "range", "id": "autoplay_interval", "label": "Autoplay interval", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 5 },
    { "type": "checkbox", "id": "show_pagination", "label": "Show pagination dots", "default": true },
    { "type": "checkbox", "id": "show_thumbnails", "label": "Show thumbnails", "info": "Replaces pagination dots.", "default": false },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1", "label": "Square" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" }
      ],
      "default": "4 / 3"
    },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slider gallery",
      "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
